# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit credentials.

proxmox_url      = "https://10.10.10.1:8006"
proxmox_user     = "root@pam"
proxmox_password = "YOUR_PROXMOX_PASSWORD"
proxmox_node     = "proxmox"
storage_pool     = "local-lvm"

# ISO filenames as they appear in Proxmox storage
windows_iso = "windows-server-2025.iso"
rocky_iso   = "Rocky-9-latest-x86_64-minimal.iso"
virtio_iso  = "virtio-win.iso"
